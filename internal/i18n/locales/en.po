msgid "command.add"
msgstr "Adds people to the group"

msgid "command.add.contact"
msgstr "Contacts, or phone numbers with their country code"

msgid "command.kick"
msgstr "Removes members from the group"

msgid "command.kick.member"
msgstr "Who to remove"

msgid "command.promote"
msgstr "Makes members group admins"

msgid "command.promote.member"
msgstr "Who to make an admin"

msgid "command.demote"
msgstr "Dismisses group admins"

msgid "command.demote.member"
msgstr "Which admin to dismiss"

msgid "command.link"
msgstr "Shows the group's invite link"

msgid "command.lockdown"
msgstr "Lets only admins send messages, or everyone again"

msgid "command.lockdown.mode"
msgstr "on: only admins send; off: everyone sends"

msgid "command.description"
msgstr "Changes the group description"

msgid "command.description.text"
msgstr "The new description"

msgid "command.sticker"
msgstr "Turns the photo you reply to, or a picture you pick, into a sticker"

msgid "command.sticker.top"
msgstr "Text along the top; # starts the bottom text"

msgid "command.sticker.bottom"
msgstr "Text along the bottom"

msgid "command.purge"
msgstr "Deletes the last messages for everyone, or those up to the one you reply to"

msgid "command.purge.count"
msgstr "How many messages to delete"

msgid "command.raffle"
msgstr "Draws members of the group at random and announces them"

msgid "command.raffle.winners"
msgstr "How many to draw (1 if you leave it out)"

msgid "command.calc"
msgstr "Works out a sum as you type, and sends it with the answer"

msgid "command.calc.sum"
msgstr "Like 12 x 4500, 15k x 3 or 15% x 80000; ans is the last answer"

msgid "command.schedule"
msgstr "Sends a message later, even with the window closed"

msgid "command.schedule.when"
msgstr "Like 21:00, 30m, 2h, tomorrow 08:00, fri 18:00 or 25/12 09:00"

msgid "command.schedule.message"
msgstr "What to send; @mentions work as in any message"

msgid "command.scheduled"
msgstr "Lists the messages scheduled in this chat, to send now or cancel"

msgid "command.afk"
msgstr "Replies for you while you're away, until you send a message"

msgid "command.afk.reason"
msgstr "Why you're away, shown in the reply"

msgid "command.ghost"
msgstr "Goes invisible: no read receipts, shown offline, no sending, until you turn it off"

msgid "command.snippet"
msgstr "Sends a saved message, or saves the message you reply to"

msgid "command.snippet.action"
msgstr "send a saved message, or save the message you reply to"

msgid "command.snippet.snippet"
msgstr "the snippet to send, or the name to save it under (made up when empty)"

msgid "command.catch"
msgstr "Shows the original payload of the message you reply to"

msgid "command.fakemsg"
msgstr "quotes a message where you can change the sender and text"

msgid "command.fakemsg.sender"
msgstr "Sender of the fake message, could be 0 or their phone number with country code"

msgid "command.fakemsg.text"
msgstr "your text"

msgid "command.fakemsg.quoted"
msgstr "their fake text"

msgid "command.hidetag"
msgstr "Sends a message that mentions everyone in the group without showing it"

msgid "command.hidetag.text"
msgstr "The message to send"

msgid "ghost.mode.on"
msgstr "Ghost mode is on. Chats you open and status updates you watch send no read receipts, and you show as offline, even while the app is open. Chats you read here stay unread on your phone. You can't send messages, react or vote until you turn it off, and you don't see who's typing. Scheduled messages and AFK replies still go out."

